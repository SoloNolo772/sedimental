# =============================================================================
# Sedimental AWS EC2 GPU Deployment Configuration
# =============================================================================
# This file contains configuration settings for the start, stop, and status
# management scripts. Copy this file and fill in the values after deploying
# the CloudFormation stack.
#
# Usage:
#   1. Copy this file to config.env:  cp config.env.example config.env
#   2. Deploy the CloudFormation stack (see deploy/docs/DEPLOYMENT.md)
#   3. Copy the output values from CloudFormation into config.env
#   4. Run the management scripts (start-instance, stop-instance, status-instance)
# =============================================================================

# -----------------------------------------------------------------------------
# AWS PROFILE (REQUIRED)
# -----------------------------------------------------------------------------
# The AWS CLI profile name to use for all AWS operations.
# This ensures scripts use project-specific IAM credentials instead of
# system default credentials.
#
# IMPORTANT: This must match a profile configured in your AWS CLI.
# To create a profile, run: aws configure --profile sedimental
#
# Example: AWS_PROFILE=sedimental
AWS_PROFILE=sedimental

# -----------------------------------------------------------------------------
# INSTANCE CONFIGURATION (REQUIRED - from CloudFormation outputs)
# -----------------------------------------------------------------------------
# The EC2 instance ID created by the CloudFormation stack.
# Find this in the CloudFormation stack outputs as "InstanceId".
#
# Example: INSTANCE_ID=i-0123456789abcdef0
INSTANCE_ID=

# The AWS region where the stack is deployed.
# This should match the region where you deployed the CloudFormation stack.
#
# Example: REGION=us-west-2
REGION=us-east-1

# The S3 bucket name for configuration file distribution.
# Find this in the CloudFormation stack outputs as "ConfigBucketName".
# The start script uploads docker-compose.prod.yml and Caddyfile to this bucket.
#
# Example: CONFIG_BUCKET=sedimental-stack-config-123456789012
CONFIG_BUCKET=

# -----------------------------------------------------------------------------
# NETWORK CONFIGURATION (OPTIONAL - for display purposes)
# -----------------------------------------------------------------------------
# The Elastic IP address assigned to the instance.
# Find this in the CloudFormation stack outputs as "ElasticIP".
# Used by status script to display the public URL.
#
# Example: ELASTIC_IP=52.10.20.30
ELASTIC_IP=

# The domain name configured for HTTPS access (if any).
# This should match the DomainName parameter used in CloudFormation.
# Leave empty if using IP-only access.
#
# Example: DOMAIN_NAME=sedimental.example.com
DOMAIN_NAME=sedimental.io

# -----------------------------------------------------------------------------
# TIMEOUT CONFIGURATION (OPTIONAL - defaults shown)
# -----------------------------------------------------------------------------
# Maximum time (in seconds) to wait for the instance to reach "running" state.
# Increase this if your instance takes longer to start.
START_TIMEOUT=300

# Maximum time (in seconds) to wait for the instance to reach "stopped" state.
# Increase this if your instance takes longer to stop gracefully.
STOP_TIMEOUT=120

# Maximum time (in seconds) to wait for the health endpoint to respond.
# This includes time for Docker services to start and become healthy.
# Increase this if your application takes longer to initialize.
HEALTH_CHECK_TIMEOUT=180

# Interval (in seconds) between health check retry attempts.
HEALTH_CHECK_INTERVAL=10
