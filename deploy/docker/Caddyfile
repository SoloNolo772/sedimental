# =============================================================================
# Sedimental Analysis Tool - Caddy Reverse Proxy Configuration
# =============================================================================
# This Caddyfile configures Caddy as a reverse proxy for the Sedimental
# application with automatic HTTPS via Let's Encrypt.
#
# Configuration Distribution:
# - This file is stored in the Git repository at deploy/docker/Caddyfile
# - The start script uploads it to S3 before starting the EC2 instance
# - The User Data script downloads it to /data/Caddyfile on boot
# - The DOMAIN_NAME environment variable is set by the User Data script
#
# Domain Configuration:
# - Uses {$DOMAIN_NAME} environment variable for the domain
# - Caddy automatically obtains Let's Encrypt certificates for the domain
# - HTTP requests are automatically redirected to HTTPS
#
# Requirements: 3.1, 3.2, 3.3, 3.4
# =============================================================================

# -----------------------------------------------------------------------------
# Main Site Block - HTTPS with Automatic Certificate Management
# -----------------------------------------------------------------------------
# Caddy automatically:
# - Obtains Let's Encrypt certificates for {$DOMAIN_NAME}
# - Renews certificates before expiry (30 days before)
# - Redirects HTTP to HTTPS
# - Enables HTTPS by default when a domain is specified
# -----------------------------------------------------------------------------
{$DOMAIN_NAME} {
    # Reverse proxy all requests to the Sedimental application
    reverse_proxy sedimental:8080 {
        # Health check configuration for load balancing (single backend)
        health_uri /health
        health_interval 30s
        health_timeout 10s
        
        # Pass original client information to the backend
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    
    # Logging configuration
    log {
        output file /data/caddy_data/access.log {
            roll_size 100mb
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }
    
    # Security headers
    header {
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # Enable XSS protection
        X-XSS-Protection "1; mode=block"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    
    # Handle errors gracefully
    handle_errors {
        respond "{err.status_code} {err.status_text}"
    }
}
